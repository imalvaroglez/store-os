rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function userRole(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRole(request.auth.uid) == 'super_admin';
    }
    // Canonical control-plane document. adminStores/{storeId} remains the source
    // of authority for membership/ownership. A super_admin is also allowed to
    // operate any store's business data by explicit platform policy.
    function adminStore(storeId) {
      return get(/databases/$(database)/documents/adminStores/$(storeId)).data;
    }
    function isMember(storeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminStores/$(storeId))
        && adminStore(storeId).memberUids.hasAny([request.auth.uid]);
    }
    function isOwner(storeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminStores/$(storeId))
        && adminStore(storeId).ownerUid == request.auth.uid;
    }
    function canOperateStore(storeId) {
      return isSuperAdmin() || isMember(storeId);
    }
    function roleIs(r) { return request.resource.data.role == r; }
    // Verified email from the Firebase Auth JWT. The doc-body email field is
    // client-supplied and trivially spoofable, so super_admin escalation MUST be
    // gated on this verified token value, not request.resource.data.email.
    function verifiedEmail() { return request.auth.token.email; }
    // Verified-email guard: an unverified token proves nothing (no profile, no
    // invite reconciliation, no invitee branches).
    function hasVerifiedEmail() {
      return isSignedIn() && verifiedEmail() != null && request.auth.token.email_verified == true;
    }
    // Canonical email (must mirror normalizeEmail in src/app/firebase/auth.ts):
    // lowercase + strip local-part dots on Gmail, googlemail == gmail.
    function canonicalEmail() {
      let parts = verifiedEmail().lower().split('@');
      return (parts[1] == 'gmail.com' || parts[1] == 'googlemail.com')
        ? parts[0].replace('\\.', '') + '@gmail.com'
        : parts[0] + '@' + parts[1];
    }
    // Defense-in-depth: even if the prod users/ collection is emptied by accident,
    // only these verified email(s) may create a super_admin doc. The next arbitrary
    // signup cannot escalate. Keep member self-signup open. Platform super-admins
    // operate in both dev and prod by design; tenant owners like Olivia are
    // members/owners and do NOT need to be listed here. Keep in sync with
    // PLATFORM_ADMIN_EMAILS in src/app/firebase/auth.ts (#353 recovery, 2026-11-12:
    // platform administration moved to the PO's real account).
    function isAllowlistedSuperAdmin() {
      // Canonical comparison, same semantics as the client's normalizeEmail:
      // a legitimate dot variant (i.malvaroglez@gmail.com) or googlemail form
      // of a platform email must not produce an "admin fantasma" — client-side
      // super_admin with rules-side denial (#385 review, MAYOR-1). Callers
      // already require hasVerifiedEmail(), so verifiedEmail() is non-null.
      return canonicalEmail() in [
        'admin@store.os',
        'imalvaroglez@gmail.com'
      ];
    }

    // users/{uid} — identities are private (#176): an account reads only its
    // own profile and only the platform super_admin can browse the directory.
    // The former any-signed-in read allowed cross-store email enumeration.
    // There is no first-user bootstrap count either: the allowlist above is
    // the only path to a super_admin doc, so the client grants super_admin by
    // verified email, never by counting the directory. Self create/update
    // require a VERIFIED email and identity fields consistent with the token
    // (anti-spoofing: a user can never claim someone else's — or an
    // unverified — email/emailNormalized/emailVerified). Cross-user updates by
    // super_admin may change role but never the identity fields.
    match /users/{uid} {
      allow get: if isSelf(uid) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSelf(uid)
        && hasVerifiedEmail()
        && request.resource.data.email == verifiedEmail()
        && request.resource.data.emailNormalized == canonicalEmail()
        && request.resource.data.emailVerified == true
        && (roleIs('member')
            || (roleIs('super_admin') && isAllowlistedSuperAdmin()));
      allow update: if (isSuperAdmin()
          || (isSelf(uid)
            && hasVerifiedEmail()
            && request.resource.data.email == verifiedEmail()
            && request.resource.data.emailNormalized == canonicalEmail()
            && request.resource.data.emailVerified == true))
        && (isSuperAdmin()
            || (isSelf(uid) && hasVerifiedEmail() && isAllowlistedSuperAdmin()
                && request.resource.data.role == 'super_admin')
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        && (isSelf(uid) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'emailNormalized', 'emailVerified']));
      allow delete: if isSuperAdmin();
    }

    // adminStores/{storeId} — canonical control plane. Carries ONLY control
    // metadata (storeId, name, ownerUid, memberUids) and never business content.
    // super_admin reads all (platform administration); members read their own;
    // owners and super_admins may write. retainedPrivacyRequestCount is a control counter
    // (Espec 2) carried here because it is control data, not catalog content.
    // Invitee reconciliation (reliable-member-invitations): a verified user
    // named in pendingInvites may, in ONE write, add exactly their own uid to
    // memberUids and remove exactly their canonical email from pendingInvites.
    // Nothing else may change (no ownerUid, no other members, no business fields).
    function inviteeJoinOk() {
      return hasVerifiedEmail()
        // #274: an already-member with a stale self-invite must not use the
        // join path to add SOMEONE ELSE'S uid — the requester must not be a
        // member yet.
        && !resource.data.memberUids.hasAny([request.auth.uid])
        && resource.data.pendingInvites.hasAny([canonicalEmail()])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'pendingInvites'])
        && request.resource.data.memberUids.hasAny([request.auth.uid])
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.pendingInvites.size() == resource.data.pendingInvites.size() - 1
        && !request.resource.data.pendingInvites.hasAny([canonicalEmail()]);
    }

    match /adminStores/{storeId} {
      allow get: if isSuperAdmin() || isMember(storeId);
      allow list: if isSuperAdmin();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.hasAny([request.auth.uid]);
      allow update: if ((isSuperAdmin() || isOwner(storeId))
          && request.resource.data.memberUids.hasAny([request.resource.data.ownerUid]))
        || inviteeJoinOk();
      allow delete: if false;
    }

    match /stores/{id} {
      allow get: if canOperateStore(id);
      allow list: if isSignedIn()
        && (isSuperAdmin()
            || resource.data.memberUids.hasAny([request.auth.uid])
            // Invitee discovery: a verified user may list exactly the stores
            // whose pendingInvites name THEM (canonical email).
            || (hasVerifiedEmail() && resource.data.pendingInvites.hasAny([canonicalEmail()])));
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.hasAny([request.auth.uid]);
      // Owners and super_admins can manage store settings. The new owner must
      // already be a member. Ordinary members cannot alter store settings —
      // EXCEPT business-content fields (#253 packaging, #254 pricingRules):
      // a member may update those + updatedAt while EVERY known setting field
      // stays identical. (diff().affectedPaths() is unsupported by the
      // emulator, so this is expressed as unchanged-field equality; any field
      // added to Store later must join this list.)
      allow update: if ((isSuperAdmin() || isOwner(id))
          && request.resource.data.memberUids.hasAny([request.resource.data.ownerUid]))
        || inviteeJoinOk()
        // #274: allow-list, not deny-list — members may touch ONLY the
        // business-content fields; affectedKeys() IS emulator-supported
        // (unlike affectedPaths()) and is already proven in inviteeJoinOk.
        || (canOperateStore(id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['packaging', 'pricingRules', 'updatedAt']))

      allow delete: if isSuperAdmin() || isOwner(id);
    }

    // Entities: `get`/write gated by store access; `list` is used with a
    // storeId query by the client. Super_admins may operate every store.
    match /products/{id} {
      allow get: if (resource == null && isSignedIn()) || canOperateStore(resource.data.storeId);
      allow list: if canOperateStore(resource.data.storeId);
      allow create: if canOperateStore(request.resource.data.storeId);
      allow update: if canOperateStore(resource.data.storeId)
        && canOperateStore(request.resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId;
      allow delete: if canOperateStore(resource.data.storeId);
    }
    // categories/{id} — per-store category entity. id is `${storeId}__${slug}`,
    // and storeId is also carried on the doc so membership scoping is consistent
    // with products/customers/orders.
    match /categories/{id} {
      allow read: if canOperateStore(resource.data.storeId);
      allow create: if canOperateStore(request.resource.data.storeId);
      allow update: if canOperateStore(resource.data.storeId)
        && canOperateStore(request.resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId;
      allow delete: if canOperateStore(resource.data.storeId);
    }
    // suppliers/{id} — per-store supplier entity (private, membership-gated).
    // Mirrors categories: id carries storeId, and the doc also carries storeId
    // so membership scoping stays consistent with products/customers/orders.
    match /suppliers/{id} {
      allow read: if canOperateStore(resource.data.storeId);
      allow create: if canOperateStore(request.resource.data.storeId);
      allow update: if canOperateStore(resource.data.storeId)
        && canOperateStore(request.resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId;
      allow delete: if canOperateStore(resource.data.storeId);
    }
    // purchases/{id} — per-store supplier purchase transaction (private). Cost
    // history lives here; never written to the anonymous-readable projections.
    match /expenses/{id} {
      // #184 loose expenses: same store isolation as every data collection.
      allow read: if canOperateStore(resource.data.storeId);
      allow create: if canOperateStore(request.resource.data.storeId);
      allow update: if canOperateStore(resource.data.storeId)
        && canOperateStore(request.resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId
        && resource.data.amount == request.resource.data.amount
        && resource.data.date == request.resource.data.date
        && resource.data.createdAt == request.resource.data.createdAt;
      allow delete: if canOperateStore(resource.data.storeId)
        // #184: an expense with assignments or consumptions is money evidence
        // (server-side guard; the UI blocks it too).
        && !(('assignments' in resource.data) && resource.data.assignments.size() > 0)
        && !(('supply' in resource.data) && ('consumptions' in resource.data.supply) && resource.data.supply.consumptions.size() > 0);
    }

    match /purchases/{id} {
      // #373: same null-safe get as orders/products — the revision-aware save
      // transaction reads the doc BEFORE deciding create-vs-update, so a
      // missing purchase must read cleanly for signed-in operators (the
      // storeId gate still applies to everything that exists).
      allow get: if (resource == null && isSignedIn()) || canOperateStore(resource.data.storeId);
      allow list: if canOperateStore(resource.data.storeId);
      allow create: if canOperateStore(request.resource.data.storeId);
      // A received purchase is inventory evidence: stock was already applied,
      // so it must never be mutated or deleted by anyone (the app blocks it
      // in the UI; the rules are the real guarantee against SDK writes).
      // FER-02 (#126) exception: appending a post-reception expense adjustment
      // — saleCostAdjustments never feeds stock, product cost or the supplier
      // document, so the evidence itself stays byte-identical.
      allow update: if canOperateStore(resource.data.storeId)
        && canOperateStore(request.resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId
        && (
          // .get(): a legacy purchase may predate the status field — an absent
          // status must not blow up the whole evaluation (#373).
          resource.data.get('status', '') != 'received'
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saleCostAdjustments', 'updatedAt'])
        );
      allow delete: if canOperateStore(resource.data.storeId)
        && resource.data.status != 'received';
    }
    match /customers/{id} {
      allow read: if canOperateStore(resource.data.storeId);
      allow create: if canOperateStore(request.resource.data.storeId);
      allow update: if canOperateStore(resource.data.storeId)
        && canOperateStore(request.resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId;
      allow delete: if canOperateStore(resource.data.storeId);
    }
    // Mirror orderAmountCents using the canonical decimal text, including
    // scientific notation. Neither multiplication nor half-cent float bounds
    // preserve rounding at both 1.005 and large historical decimal amounts.
    function receiptCents(amount) {
      let parts = string(math.abs(amount)).lower().split('e');
      let coefficient = parts[0].split('[.]');
      let exponent = parts.size() > 1 ? int(parts[1]) : 0;
      let digits = parts[0].replace('[.]', '');
      let at = coefficient[0].size() + exponent + 2;
      let prefix = at <= 0 ? '0' : (at < digits.size() ? digits[0:at]
        : (at == digits.size() ? digits : digits + '000000000000000'[0:at - digits.size()]));
      let next = at >= 0 && at < digits.size() ? digits[at] : '0';
      let magnitude = int(prefix) + (next >= '5' ? 1 : 0);
      return amount < 0 ? -magnitude : magnitude;
    }
    function validReceipt(data, orderId, paymentId) {
      return data.id == paymentId && data.orderId == orderId
        && data.createdBy == request.auth.uid
        && data.createdAt is string && data.createdAt.size() > 0
        && data.amount is number && data.amount != 0
        && math.abs(data.amount) <= 9000000000000
        && data.amountCents is int && math.abs(data.amountCents) <= 900000000000000
        && data.amountCents == receiptCents(data.amount)
        && data.kind in ['payment', 'adjustment']
        && (data.kind == 'adjustment' || data.amount > 0)
        && (data.kind != 'adjustment' || (data.note is string && data.note.trim().size() > 0))
        && ((paymentId == 'inherited_deposit' && data.kind == 'payment'
              && data.method in ['cash', 'transfer']
              && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
            || (paymentId != 'inherited_deposit'
              && ((data.kind == 'adjustment' && data.method in ['cash', 'transfer', 'unknown'])
                || (data.kind == 'payment' && data.method in ['cash', 'transfer']
                  && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))));
    }
    function validInheritedReceipt(orderId, before, after) {
      let path = /databases/$(database)/documents/orders/$(orderId)/payments/inherited_deposit;
      let receipt = getAfter(path).data;
      return before.get('inheritedDepositMaterialized', false) == false
        && after.get('inheritedDepositMaterialized', false) == true
        && !exists(path)
        && before.get('deposit', 0) > 0 && receipt.amount == before.deposit
        && receipt.storeId == before.storeId;
    }
    function validMoneyUpdate(orderId, before, after) {
      let paymentId = after.get('lastPaymentId', '');
      let path = /databases/$(database)/documents/orders/$(orderId)/payments/$(paymentId);
      let receipt = getAfter(path).data;
      let inheritedChanged = before.get('inheritedDepositMaterialized', false) != after.get('inheritedDepositMaterialized', false);
      return paymentId is string && paymentId.size() > 0 && paymentId != 'inherited_deposit'
        && paymentId != before.get('lastPaymentId', '') && !exists(path)
        && receipt.orderId == orderId && receipt.storeId == before.storeId
        && before.get('paymentsRevision', 0) is int && before.get('paymentsRevision', 0) >= 0
        && after.paymentsRevision is int && after.paymentsRevision <= 9007199254740991
        && after.paymentsRevision == before.get('paymentsRevision', 0) + 1
        && after.paymentsReceivedCents is int && math.abs(after.paymentsReceivedCents) <= 9007199254740991
        && before.get('paymentsReceivedCents', 0) is int
        && math.abs(before.get('paymentsReceivedCents', 0)) <= 9007199254740991
        // #270 (PO 2026-11-09): received money never crosses below zero — a
        // "Restar" adjustment is capped at what THIS order received, so no
        // phantom debt can absorb a sister order's real saldo a favor. A
        // legacy negative accumulator may only climb back (never deepen).
        && (after.paymentsReceivedCents >= 0
            || after.paymentsReceivedCents > before.get('paymentsReceivedCents', 0))
        && (!inheritedChanged || validInheritedReceipt(orderId, before, after))
        && after.paymentsReceivedCents == before.get('paymentsReceivedCents', 0) + receipt.amountCents
          + (inheritedChanged
            ? getAfter(/databases/$(database)/documents/orders/$(orderId)/payments/inherited_deposit).data.amountCents : 0);
    }
    function receiptUpdatesParent(orderId, paymentId, receipt) {
      let path = /databases/$(database)/documents/orders/$(orderId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return receipt.storeId == before.storeId
        && after.get('lastPaymentId', '') != before.get('lastPaymentId', '')
        && (paymentId == 'inherited_deposit'
          ? (before.get('inheritedDepositMaterialized', false) == false
              && after.get('inheritedDepositMaterialized', false) == true
              && after.lastPaymentId != 'inherited_deposit' && receipt.amount == before.get('deposit', 0))
          : after.lastPaymentId == paymentId);
    }
    // #271 (PO 2026-11-09): a deposit LOWERING on an order with an accumulator
    // and no materialization is valid ONLY as a signed correction. The trail
    // itself is strictly append-only: a write that touches depositCorrections
    // must keep it VERBATIM identical or append exactly one well-formed entry
    // (deep list equality `next == prev + [entry]` — same-size rewrites and
    // fabricated appends without a real lowering are denied). The entry needs
    // a non-blank note, a timestamp, from/to matching the real deposit change,
    // and the CALLER's signature.
    function validDepositCorrection(before, after) {
      let prev = before.get('depositCorrections', []);
      let next = after.get('depositCorrections', []);
      // Guarded: indexing an empty list errors OUTSIDE short-circuit order.
      let entry = next.size() > 0 ? next[next.size() - 1] : {};
      // ponytail: this CEL has no list concat/slice/lambdas, so a rewritten
      // PREFIX smuggled inside a genuine lowering cannot be verified here —
      // the transaction always carries the doc's own trail verbatim, and
      // every non-lowering write must keep the trail deep-equal.
      return next is list && prev is list && next.size() == prev.size() + 1
        && after.get('inheritedDepositMaterialized', false) == before.get('inheritedDepositMaterialized', false)
        && after.get('deposit', 0) < before.get('deposit', 0)
        && entry.get('from', -1) == before.get('deposit', 0)
        && entry.get('to', -1) == after.get('deposit', 0)
        && entry.get('note', '') is string && !entry.get('note', '').matches('^\\s*$')
        && entry.get('at', '') is string && entry.get('at', '').size() > 0
        && entry.get('by', '') == request.auth.uid;
    }
    // #333: the delivery ledger is strictly append-only. A write touching
    // `deliveries` keeps it VERBATIM identical or appends exactly ONE
    // well-formed event signed by the caller. Structural essentials of the
    // last entry are checked (ids, effective date shape, signature, non-empty
    // lines); per-line quantities are validated by the registering
    // transaction against the fresh doc (never more than pending) — the same
    // split of concerns as depositCorrections above.
    function validDeliveryAppend(orderId, before, after) {
      let prev = before.get('deliveries', []);
      let next = after.get('deliveries', []);
      let entry = next.size() > 0 ? next[next.size() - 1] : {};
      // Per-line CONTENT checks are impossible here (no list lambdas; slice
      // comparisons hit the 1000-expression limit) — the registering
      // transaction owns them; the rules own structure, signature, order.
      return next is list && prev is list && next.size() == prev.size() + 1
        // hasAll: every previous event survives UNCHANGED behind the append
        // (review P2 — closes the mid/prefix rewrite that next[0] missed).
        && next.hasAll(prev)
        && entry.get('id', '') is string && entry.get('id', '').size() > 0
        && entry.get('orderId', '') == orderId
        && entry.get('storeId', '') == after.get('storeId', '')
        && entry.get('deliveredAt', '') is string
        && entry.get('deliveredAt', '').matches('^\\d{4}-\\d{2}-\\d{2}$')
        && entry.get('recordedAt', '') is string && entry.get('recordedAt', '').size() > 0
        && entry.get('by', '') == request.auth.uid
        && entry.get('lines', []) is list && entry.get('lines', []).size() > 0
        && entry.get('lines', []).size() <= 200
        // A sane effective-date year — junk like 2099 never reaches the ledger.
        // (Per-line content checks are IMPOSSIBLE here: this CEL has no list
        // lambdas and the 1000-expression limit rejects slice comparisons —
        // verified empirically. Content validity is the registering
        // transaction's job; the rules own structure, signature, append-only.)
        // Sanity bound, not a business rule: this CEL cannot parse dates, so
        // the effective year must fall inside the app's plausible lifetime.
        && int(entry.get('deliveredAt', '0000')[0:4]) >= 2020
        && int(entry.get('deliveredAt', '0000')[0:4]) <= 2035;
    }
    match /orders/{id} {
      allow get: if (resource == null && isSignedIn()) || canOperateStore(resource.data.storeId);
      allow list: if canOperateStore(resource.data.storeId);
      allow create: if canOperateStore(request.resource.data.storeId)
        && !request.resource.data.keys().hasAny(['paymentsReceivedCents', 'inheritedDepositMaterialized', 'lastPaymentId', 'paymentsRevision', 'depositCorrections', 'deliveries']);
      allow update: if canOperateStore(resource.data.storeId)
        && canOperateStore(request.resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentsReceivedCents', 'inheritedDepositMaterialized', 'lastPaymentId', 'paymentsRevision'])
            || validMoneyUpdate(id, resource.data, request.resource.data))
        // #218: legacy deposit cannot rise after receipts, and is frozen once
        // materialized. #271: with an accumulator and no materialization it can
        // only stay equal or go DOWN as a signed correction entry.
        && (!('paymentsReceivedCents' in resource.data)
            || (('deposit' in request.resource.data || !('deposit' in resource.data))
                && (request.resource.data.get('deposit', 0) == resource.data.get('deposit', 0)
                    || (request.resource.data.get('deposit', 0) < resource.data.get('deposit', 0)
                        && validDepositCorrection(resource.data, request.resource.data)))))
        && (resource.data.get('inheritedDepositMaterialized', false) != true
            || (('deposit' in request.resource.data || !('deposit' in resource.data))
                && request.resource.data.get('deposit', 0) == resource.data.get('deposit', 0)))
        // Editing cannot strip the evidence that prevents orphaning a parent.
        && (!('paymentsReceivedCents' in resource.data)
            || 'paymentsReceivedCents' in request.resource.data)
        // #271: the corrections trail is append-only AND unrewritable — a
        // write touching the field (present before OR introduced now) keeps
        // it verbatim or appends one valid SIGNED entry tied to a real
        // lowering. Count-only checks let same-size rewrites and first-write
        // fabrications through; this does not.
        && (!('depositCorrections' in resource.data) && !('depositCorrections' in request.resource.data)
            || request.resource.data.get('depositCorrections', [])
                == resource.data.get('depositCorrections', [])
            || validDepositCorrection(resource.data, request.resource.data))
        // #333: the delivery ledger is append-only (verbatim carry or one
        // signed event per write); ordinary edits can never rewrite history.
        && (!('deliveries' in resource.data) && !('deliveries' in request.resource.data)
            || request.resource.data.get('deliveries', [])
                == resource.data.get('deliveries', [])
            || validDeliveryAppend(id, resource.data, request.resource.data))
        && (!('installmentsReservedAt' in resource.data)
            || request.resource.data.get('installmentsReservedAt', null) == resource.data.installmentsReservedAt)
        && (resource.data.get('inheritedDepositMaterialized', false) != true
            || request.resource.data.get('inheritedDepositMaterialized', false) == true);
      // Preserve the parent of immutable money evidence, including net-zero
      // corrections, any stock still held by an installment reservation, and
      // #333's delivery evidence (pieces handed to the clienta).
      // #363: OUTSTANDING clienta credit blocks deletion — applied (this order
      // consumed her credit) or consumed (this order BACKS credit a sister
      // already applied). A fully released order (both zero) deletes normally.
      allow delete: if canOperateStore(resource.data.storeId)
        && !('paymentsReceivedCents' in resource.data)
        && !('installmentsReservedAt' in resource.data)
        && !('deliveries' in resource.data)
        && resource.data.get('inheritedDepositMaterialized', false) != true
        && resource.data.get('creditAppliedCents', 0) == 0
        && resource.data.get('creditConsumedCents', 0) == 0;
    }

    // orders/{orderId}/payments/{paymentId} — per-order money receptions (#123).
    // Scoped by the PARENT order's storeId: the payment doc also carries storeId,
    // but the parent is the trustworthy scope, so a payment can never attach to
    // another store's order. Records are immutable evidence (corrections are NEW
    // signed docs): update/delete are denied to everyone, super_admin included.
    // #168 F5: create also validates CONTENT — a real amount inside safe cents
    // precision (|amount| ≤ 9e12), known method/kind enums, cobros strictly
    // positive, adjustments non-zero and signed WITH their note (the evidence).
    // Each rule get() of the parent order counts as one Firestore read.
    match /orders/{orderId}/payments/{paymentId} {
      allow get, list: if canOperateStore(get(/databases/$(database)/documents/orders/$(orderId)).data.storeId);
      allow create: if canOperateStore(request.resource.data.storeId)
        && validReceipt(request.resource.data, orderId, paymentId)
        && receiptUpdatesParent(orderId, paymentId, request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // --- Public catalog (anonymous-readable projections) ---
    // Private fields are NEVER written here, so anonymous reads physically cannot
    // see cost, profit, privateNotes, inventory, or membership data.

    // slugs/{slug} — global slug reservation. Doc existence IS the lock. `get` is
    // allowed for signed-in clients (the claim transaction reads-then-creates to
    // enforce atomic uniqueness); `list` is always denied (no enumeration).
    match /slugs/{slug} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin()
        || (isSignedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow delete: if isOwner(resource.data.storeId)
        || isSuperAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /publicStores/{slug} {
      // get is public (the storefront + prerender read by slug); list requires a
      // signed-in platform user so the public apiKey alone cannot enumerate the
      // tenant directory or bulk-dump every store. (Fully denying list broke the
      // client's stale-projection prune, which queries publicProducts — caught
      // by CI e2e.) The deploy-time prerender lists via firebase-admin.
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSuperAdmin() || isOwner(request.resource.data.storeId);
      allow update: if (isSuperAdmin() || isOwner(resource.data.storeId))
        && resource.data.storeId == request.resource.data.storeId;
      allow delete: if isSuperAdmin() || isOwner(resource.data.storeId);
    }

    // publicCatalogs/{slug} — active categories + lightweight product summaries
    // for the grid, plus storeId (used to resolve publicProducts doc ids
    // anonymously). Anonymous read; signed-in write.
    match /publicCatalogs/{slug} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if canOperateStore(request.resource.data.storeId);
      allow update: if canOperateStore(resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId;
      allow delete: if canOperateStore(resource.data.storeId);
    }

    // publicProducts/{id} — public-only product detail (id = storeId__slug).
    // Anonymous read.
    match /publicProducts/{id} {
      // list is signed-in-only: the client prune query
      // (where storeSlug ==) runs as the store owner.
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if canOperateStore(request.resource.data.storeId);
      allow update: if canOperateStore(resource.data.storeId)
        && resource.data.storeId == request.resource.data.storeId;
      allow delete: if canOperateStore(resource.data.storeId);
    }
  }
}
