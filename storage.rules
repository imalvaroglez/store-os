rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mirror of Firestore `isMember`: super_admin, or a member of the store.
    // Cross-service rules only support the (default) Firestore database, which
    // is all this app uses. Two reads per write — fine for a low-volume path.
    function isStoreMember(storeId) {
      return request.auth != null && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        || firestore.get(/databases/(default)/documents/stores/$(storeId)).data.memberUids.hasAny([request.auth.uid])
      );
    }
    function isStoreOwner(storeId) {
      return request.auth != null && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        || firestore.get(/databases/(default)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid
      );
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType == 'image/jpeg'
            || request.resource.contentType == 'image/png'
            || request.resource.contentType == 'image/webp')
        && request.resource.name.matches('.*\\.jpg');
    }

    // The recursive path covers both legacy product photos and gallery photos.
    match /products/{storeId}/{path=**} {
      allow read: if true;
      allow create, update: if isStoreMember(storeId) && validImage();
      allow delete: if isStoreMember(storeId);
    }

    match /categories/{storeId}/{fileName} {
      allow read: if true;
      allow create, update: if isStoreMember(storeId) && validImage();
      allow delete: if isStoreMember(storeId);
    }

    match /storefront/{storeId}/{fileName} {
      allow read: if true;
      allow create, update: if isStoreOwner(storeId) && validImage();
      allow delete: if isStoreOwner(storeId);
    }
  }
}
