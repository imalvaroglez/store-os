{
  "name": "store-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A lightweight operating system for small stores. Firebase-first PWA.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/check-env.cjs",
    "dev": "vite",
    "build": "node scripts/check-env.cjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "bash scripts/test-rules.sh",
    "e2e": "playwright test",
    "e2e:dev": "playwright test --config=playwright.dev.config.ts",
    "deploy:dev": "node scripts/deploy-dev.cjs",
    "seed:dev": "node scripts/seed-dev.cjs",
    "deploy:rules": "firebase deploy --only firestore,storage",
    "check:rules": "node scripts/check-rules-deployed.cjs"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
