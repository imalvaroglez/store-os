{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/delivery-hook.cjs\"",
            "timeout": 30,
            "statusMessage": "Validando gate de publicación"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^store-os-(explorer|reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/delivery-hook.cjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/delivery-hook.cjs\"",
            "timeout": 30,
            "statusMessage": "Comprobando estado terminal"
          }
        ]
      }
    ]
  }
}
