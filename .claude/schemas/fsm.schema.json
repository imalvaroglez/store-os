{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://store-os/schemas/fsm.schema.json",
  "title": "Software delivery FSM",
  "description": "Validates the canonical state-machine definition. The workflow rejects an invalid FSM before spawning workers.",
  "type": "object",
  "required": ["fsm_version", "description", "concurrency", "retry_policy", "states", "mandatory_states", "terminal_states"],
  "additionalProperties": false,
  "properties": {
    "fsm_version": { "type": "string" },
    "description": { "type": "string" },
    "concurrency": {
      "type": "object",
      "required": ["max_parallel_editors", "review_quorum", "max_retries_per_state", "no_progress_threshold"],
      "properties": {
        "max_parallel_editors": { "type": "integer", "minimum": 1 },
        "review_quorum": { "type": "integer", "minimum": 1 },
        "max_retries_per_state": { "type": "integer", "minimum": 0 },
        "no_progress_threshold": { "type": "integer", "minimum": 1 }
      }
    },
    "retry_policy": { "type": "object" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/state" }
    },
    "mandatory_states": { "type": "array", "items": { "type": "string" } },
    "terminal_states": { "type": "array", "items": { "type": "string" } },
    "parallel_groups": { "type": "array", "items": { "$ref": "#/definitions/parallelGroup" } }
  },
  "definitions": {
    "state": {
      "type": "object",
      "required": [
        "id", "purpose", "agent", "read_only", "worktree", "risk",
        "inputs", "outputs", "entry_conditions", "exit_conditions",
        "deterministic_commands", "review", "allowed_next",
        "retry_limit", "timeout_ms", "on_failure", "on_escalation", "evidence_required"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "purpose": { "type": "string" },
        "agent": { "type": "string" },
        "read_only": { "type": "boolean" },
        "worktree": { "type": "boolean" },
        "risk": { "enum": ["none", "low", "medium", "high"] },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "entry_conditions": { "type": "array", "items": { "type": "string" } },
        "exit_conditions": { "type": "array", "items": { "type": "string" } },
        "deterministic_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "cmd", "must_pass"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "cmd": { "type": "string" },
              "must_pass": { "type": "boolean" },
              "contextual": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "review": {
          "type": "object",
          "required": ["required"],
          "properties": {
            "required": { "type": "boolean" },
            "quorum": { "type": "integer", "minimum": 1 },
            "agent": { "type": "string" },
            "independent": { "type": "boolean" }
          }
        },
        "allowed_next": { "type": "array", "items": { "type": "string" } },
        "retry_limit": { "type": "integer", "minimum": 0 },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "on_failure": { "type": "string" },
        "on_escalation": { "type": "string" },
        "evidence_required": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "parallelGroup": {
      "type": "object",
      "required": ["id", "trigger", "members", "join"],
      "properties": {
        "id": { "type": "string" },
        "trigger": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "join": { "type": "string" }
      }
    }
  }
}
