# Firebase configuration. Copy this file to `.env` for local development.
# The placeholder values below are for Firebase Emulators only; replace them
# with the real public config and set VITE_FIREBASE_EMULATOR=false to connect
# directly to store-os-dev.
# These keys are PUBLIC by design — access is enforced by Firestore Security Rules.

VITE_FIREBASE_API_KEY=emulator-only-placeholder
VITE_FIREBASE_AUTH_DOMAIN=store-os-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=store-os-dev
VITE_FIREBASE_STORAGE_BUCKET=store-os-dev.firebasestorage.app
VITE_FIREBASE_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Set to "true" to route Auth + Firestore + Storage to local emulators
# (npm run emulators). The project and bucket IDs match store-os-dev; every
# service host remains 127.0.0.1, so emulator traffic stays on this computer.
VITE_FIREBASE_EMULATOR=true

# Optional: override the Storage emulator host (defaults to 127.0.0.1:9199).
# VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
