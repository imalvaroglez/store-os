# Firebase configuration for LOCALHOST. Copy this file to `.env.local` and fill
# in the Web App values from the store-os-dev Firebase console. These keys are
# public by design — access is enforced by Firestore Security Rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=store-os-dev
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Localhost and integration tests use store-os-dev.
